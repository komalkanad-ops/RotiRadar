# Database — MySQL. Local dev: a local MySQL/MariaDB. Production: the Hostinger MySQL database
# (hPanel -> Databases). The host is usually srvNNN.hstgr.io, not localhost.
DATABASE_URL="mysql://rotiradar:changeme@localhost:3306/rotiradar_dev"

PORT=4000
NODE_ENV=development

# Long random string — sign customer/cook/admin JWTs.
JWT_SECRET="changeme-generate-a-long-random-string"

# First admin account, created on boot if it doesn't exist.
ADMIN_BOOTSTRAP_EMAIL="admin@rotiradar.in"
ADMIN_BOOTSTRAP_PASSWORD="changeme"

# Error monitoring — no-ops until set. Free Sentry account -> Node project -> paste the DSN.
SENTRY_DSN=

# Razorpay — test mode keys are free and self-serve (Dashboard -> Account & Settings -> API Keys,
# Test Mode). The webhook secret is one you choose when configuring the webhook URL.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# SMS / OTP provider for phone login (Phase 1). Firebase Auth or an SMS gateway — TBD.
OTP_PROVIDER=
OTP_PROVIDER_KEY=

# Exotel — masked calling (Phase 2). Left blank until then; calling endpoints 501 cleanly.
EXOTEL_SID=
EXOTEL_TOKEN=
EXOTEL_VIRTUAL_NUMBER=
