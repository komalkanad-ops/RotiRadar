# The marketing site is static and mostly needs no backend. These are optional.

# Backend API base URL — only used if/when the site calls the API (e.g. live "cities we serve").
VITE_API_BASE_URL=https://api.rotiradar.in

# Contact form target. If unset, the Contact page falls back to opening the visitor's email client
# with a pre-filled message to support@rotiradar.in. Set this to a backend route
# (e.g. https://api.rotiradar.in/contact) or a form handler once one exists.
VITE_CONTACT_ENDPOINT=
